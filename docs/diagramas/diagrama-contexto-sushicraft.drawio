        <mxCell id="ea_cliente" value="consulta menu, mesas, pedidos, cuentas y reservas" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;fontColor=#333333;strokeColor=#666666;dashed=1;startArrow=none;endArrow=open;endFill=1;strokeWidth=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.86;entryDx=0;entryDy=0;" edge="1" parent="1" source="cliente_card" target="sistema"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="es_pg" value="lee/escribe - JDBC (Spring Data JPA)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;fontColor=#333333;strokeColor=#666666;dashed=1;startArrow=none;endArrow=open;endFill=1;strokeWidth=1;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="sistema" target="postgres"><mxGeometry relative="1" as="geometry"/></mxCell>
