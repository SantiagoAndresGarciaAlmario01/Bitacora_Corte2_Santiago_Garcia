        <mxCell id="gerente_card" value="&lt;b&gt;Gerente&lt;/b&gt;&lt;br/&gt;&lt;i style=\&quot;font-size:10px\&quot;&gt;[Person]&lt;/i&gt;&lt;hr size=\&quot;1\&quot;/&gt;&lt;span style=\&quot;font-size:10px\&quot;&gt;Administra todo: crea/edita/elimina platos, mesas, pedidos, cuentas, reservas y parqueadero&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#FFFFFF;strokeColor=#2E7D32;fontColor=#000000;strokeWidth=2;fontColor=#2E7D32;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="122" width="190" height="130" as="geometry"/></mxCell>
        <mxCell id="mesero_head" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E7D32;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="112.0" y="240" width="46" height="46" as="geometry"/></mxCell>
        <mxCell id="mesero_card" value="&lt;b&gt;Mesero&lt;/b&gt;&lt;br/&gt;&lt;i style=\&quot;font-size:10px\&quot;&gt;[Person]&lt;/i&gt;&lt;hr size=\&quot;1\&quot;/&gt;&lt;span style=\&quot;font-size:10px\&quot;&gt;Toma pedidos, gestiona mesas, cuentas, reservas y parqueadero (sin poder eliminar)&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#FFFFFF;strokeColor=#2E7D32;fontColor=#000000;strokeWidth=2;fontColor=#2E7D32;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="272" width="190" height="130" as="geometry"/></mxCell>
        <mxCell id="cocinero_head" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E7D32;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="112.0" y="390" width="46" height="46" as="geometry"/></mxCell>
        <mxCell id="cocinero_card" value="&lt;b&gt;Cocinero&lt;/b&gt;&lt;br/&gt;&lt;i style=\&quot;font-size:10px\&quot;&gt;[Person]&lt;/i&gt;&lt;hr size=\&quot;1\&quot;/&gt;&lt;span style=\&quot;font-size:10px\&quot;&gt;Cambia el estado de los pedidos en cocina: recibido -&amp;gt; en preparacion -&amp;gt; listo&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#FFFFFF;strokeColor=#2E7D32;fontColor=#000000;strokeWidth=2;fontColor=#2E7D32;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="422" width="190" height="130" as="geometry"/></mxCell>
        <mxCell id="cliente_head" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E7D32;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="112.0" y="540" width="46" height="46" as="geometry"/></mxCell>
        <mxCell id="cliente_card" value="&lt;b&gt;Cliente&lt;/b&gt;&lt;br/&gt;&lt;i style=\&quot;font-size:10px\&quot;&gt;[Person]&lt;/i&gt;&lt;hr size=\&quot;1\&quot;/&gt;&lt;span style=\&quot;font-size:10px\&quot;&gt;Consulta el menu, mesas, pedidos, cuentas y reservas. Solo lectura, sin login para el menu&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#FFFFFF;strokeColor=#2E7D32;fontColor=#000000;strokeWidth=2;fontColor=#2E7D32;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="572" width="190" height="130" as="geometry"/></mxCell>
        <mxCell id="sistema" value="&lt;b&gt;SISTEMA SUSHI CRAFT&lt;/b&gt;&lt;br/&gt;&lt;i style=\&quot;font-size:11px\&quot;&gt;[Software System]&lt;/i&gt;&lt;hr size=\&quot;1\&quot;/&gt;&lt;span style=\&quot;font-size:11px\&quot;&gt;API REST del restaurante. Gestiona menu, mesas, pedidos, cuentas, reservas y parqueadero. Login con JWT y permisos por rol (@PreAuthorize).&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#FFFFFF;strokeColor=#0B61A4;fontColor=#000000;strokeWidth=3;fontColor=#0B61A4;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="420" y="260" width="380" height="240" as="geometry"/></mxCell>
        <mxCell id="postgres" value="&lt;b&gt;PostgreSQL&lt;/b&gt;&lt;br/&gt;&lt;i style=\&quot;font-size:10px\&quot;&gt;[Software System]&lt;/i&gt;&lt;hr size=\&quot;1\&quot;/&gt;&lt;span style=\&quot;font-size:10px\&quot;&gt;Base de datos relacional: guarda los 7 dominios del restaurante y los usuarios (JPA/Hibernate)&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#F8CECC;strokeColor=#B85450;fontColor=#000000;strokeWidth=2;fontColor=#000000;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="940" y="200" width="260" height="160" as="geometry"/></mxCell>
        <mxCell id="mongo" value="&lt;b&gt;MongoDB&lt;/b&gt;&lt;br/&gt;&lt;i style=\&quot;font-size:10px\&quot;&gt;[Software System]&lt;/i&gt;&lt;hr size=\&quot;1\&quot;/&gt;&lt;span style=\&quot;font-size:10px\&quot;&gt;Base de datos documental: guarda el historial de eventos de cada pedido (Spring Data Mongo)&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#F8CECC;strokeColor=#B85450;fontColor=#000000;strokeWidth=2;fontColor=#000000;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="940" y="460" width="260" height="160" as="geometry"/></mxCell>
