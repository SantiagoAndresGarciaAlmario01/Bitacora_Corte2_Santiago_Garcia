        <mxCell id="title2" value="&lt;b&gt;SUSHI CRAFT (KAZE &amp;amp; NORI)&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="300" y="42" width="900" height="24" as="geometry"/></mxCell>
