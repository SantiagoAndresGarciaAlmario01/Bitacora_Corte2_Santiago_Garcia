        <mxCell id="title1" value="&lt;b&gt;Diagrama de Despliegue - CI/CD Sushi Craft&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="200" y="12" width="800" height="26" as="geometry"/></mxCell>
        <mxCell id="title2" value="&lt;i&gt;Flujo: push a GitHub -&amp;gt; build/push de imagen a Docker Hub -&amp;gt; despliegue automatico a QA -&amp;gt; aprobacion manual -&amp;gt; despliegue a PROD&lt;/i&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="100" y="40" width="1000" height="22" as="geometry"/></mxCell>

        <mxCell id="devpc" value="&lt;b&gt;PC del Desarrollador&lt;/b&gt;&lt;br/&gt;&lt;i style=\&quot;font-size:10px\&quot;&gt;[Device]&lt;/i&gt;&lt;hr size=\&quot;1\&quot;/&gt;&lt;span style=\&quot;font-size:10px\&quot;&gt;Repositorio local con el codigo fuente&lt;/span&gt;" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=12;align=center;verticalAlign=middle;size=12;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="200" height="110" as="geometry"/></mxCell>

        <mxCell id="github" value="&lt;b&gt;GitHub&lt;/b&gt;&lt;br/&gt;&lt;i style=\&quot;font-size:10px\&quot;&gt;[Device - servidor remoto]&lt;/i&gt;&lt;hr size=\&quot;1\&quot;/&gt;&lt;span style=\&quot;font-size:10px\&quot;&gt;Repositorio remoto + GitHub Actions (runner del pipeline)&lt;/span&gt;&lt;br/&gt;&lt;i style=\&quot;font-size:9px\&quot;&gt;Artefacto: ci-cd.yml&lt;/i&gt;" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=12;align=center;verticalAlign=middle;size=12;" vertex="1" parent="1"><mxGeometry x="340" y="90" width="220" height="110" as="geometry"/></mxCell>

        <mxCell id="dockerhub" value="&lt;b&gt;Docker Hub&lt;/b&gt;&lt;br/&gt;&lt;i style=\&quot;font-size:10px\&quot;&gt;[Device - registro de contenedores]&lt;/i&gt;&lt;hr size=\&quot;1\&quot;/&gt;&lt;span style=\&quot;font-size:10px\&quot;&gt;Almacena la imagen que construye el pipeline&lt;/span&gt;&lt;br/&gt;&lt;i style=\&quot;font-size:9px\&quot;&gt;Artefacto: restaurante-api:&amp;lt;tag&amp;gt;&lt;/i&gt;" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=12;align=center;verticalAlign=middle;size=12;" vertex="1" parent="1"><mxGeometry x="660" y="90" width="220" height="110" as="geometry"/></mxCell>

        <mxCell id="qa_app" value="&lt;b&gt;Azure App Service - QA&lt;/b&gt;&lt;br/&gt;&lt;i style=\&quot;font-size:10px\&quot;&gt;[Device - Linux, contenedor]&lt;/i&gt;&lt;hr size=\&quot;1\&quot;/&gt;&lt;span style=\&quot;font-size:10px\&quot;&gt;Despliegue automatico en cada push a main&lt;/span&gt;&lt;br/&gt;&lt;i style=\&quot;font-size:9px\&quot;&gt;Artefacto: app.jar (Spring Boot)&lt;/i&gt;" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#DAE8FC;strokeColor=#0B61A4;fontSize=12;align=center;verticalAlign=middle;size=12;" vertex="1" parent="1"><mxGeometry x="240" y="310" width="240" height="110" as="geometry"/></mxCell>

