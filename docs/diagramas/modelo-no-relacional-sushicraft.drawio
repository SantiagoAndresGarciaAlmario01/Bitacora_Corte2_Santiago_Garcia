<mxfile host="app.diagrams.net" version="24.0.0" type="device">
  <diagram id="sushicraft-mongo" name="Modelo no relacional (MongoDB) - Sushi Craft">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="650" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t" value="Modelo No Relacional (MongoDB) - Sushi Craft" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1000" height="30" as="geometry"/></mxCell>
        <mxCell id="subt" value="Unico dato del proyecto que vive en Mongo: el historial de eventos de cada pedido (coleccion eventos_pedido)." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=6;spacingRight=6;fontSize=11;fillColor=none;strokeColor=none;fontColor=#000000;fontSize=11;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="1000" height="24" as="geometry"/></mxCell>
        <mxCell id="pedidos_pg" value="&lt;b&gt;pedidos&lt;/b&gt; &lt;i&gt;(PostgreSQL)&lt;/i&gt;&lt;hr size=\&quot;1\&quot;/&gt;id : Long &lt;i&gt;(PK)&lt;/i&gt;&lt;br/&gt;idMesa : Long&lt;br/&gt;estado : String&lt;br/&gt;&lt;br/&gt;&lt;i&gt;Un pedido puede tener muchos eventos a lo largo del tiempo&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=6;spacingRight=6;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="260" height="130" as="geometry"/></mxCell>
        <mxCell id="evento_doc" value="&lt;b&gt;eventos_pedido&lt;/b&gt; &lt;i&gt;(coleccion Mongo)&lt;/i&gt;&lt;hr size=\&quot;1\&quot;/&gt;&lt;b&gt;EventoPedidoDocument&lt;/b&gt;&lt;br/&gt;{&lt;br/&gt;&amp;nbsp;&amp;nbsp;_id : String  &lt;i&gt;(ObjectId, PK)&lt;/i&gt;&lt;br/&gt;&amp;nbsp;&amp;nbsp;idPedido : Long  &lt;i&gt;(referencia logica)&lt;/i&gt;&lt;br/&gt;&amp;nbsp;&amp;nbsp;tipo : String  &lt;i&gt;(PEDIDO_CREADO, CAMBIO_ESTADO)&lt;/i&gt;&lt;br/&gt;&amp;nbsp;&amp;nbsp;descripcion : String&lt;br/&gt;&amp;nbsp;&amp;nbsp;timestamp : LocalDateTime&lt;br/&gt;}" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=6;spacingRight=6;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#000000;fontSize=11;fontFamily=Consolas;" vertex="1" parent="1"><mxGeometry x="440" y="90" width="340" height="220" as="geometry"/></mxCell>
        <mxCell id="rel1" value="idPedido  (1 pedido : muchos eventos) - referenciado, no embebido" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;startArrow=none;endArrow=block;endFill=1;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="pedidos_pg" target="evento_doc"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="nota" value="&lt;b&gt;Por que referenciado y no embebido?&lt;/b&gt;&lt;hr size=\&quot;1\&quot;/&gt;El pedido vive en &lt;b&gt;PostgreSQL&lt;/b&gt; (relacional) y sus eventos viven en &lt;b&gt;MongoDB&lt;/b&gt; (no relacional) - son dos motores de base de datos distintos, asi que no se pueden embeber el uno en el otro. &lt;br/&gt;&lt;br/&gt;Ademas, un mismo pedido puede generar varios eventos con el tiempo (creacion + cada cambio de estado), y esa cantidad no tiene un limite fijo, asi que conviene un documento independiente por evento en vez de una lista que crezca sin control dentro de otro documento.&lt;br/&gt;&lt;br/&gt;&lt;i&gt;idPedido&lt;/i&gt; es una referencia logica (por convencion, como el resto del proyecto), no una foreign key real: MongoDB no puede validar que ese id exista en una tabla de PostgreSQL." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=6;spacingRight=6;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="280" width="740" height="160" as="geometry"/></mxCell>
        <mxCell id="acceso" value="&lt;b&gt;Como se guarda un evento&lt;/b&gt;&lt;hr size=\&quot;1\&quot;/&gt;1. PedidoServiceImpl crea o cambia el estado de un pedido en PostgreSQL.&lt;br/&gt;&lt;br/&gt;2. Llama a IEventoPedidoService.registrar(idPedido, tipo, descripcion).&lt;br/&gt;&lt;br/&gt;3. EventoPedidoServiceImpl arma un EventoPedido (dominio) y lo pasa por EventoPedidoMapper hacia un EventoPedidoDocument.&lt;br/&gt;&lt;br/&gt;4. EventoPedidoMongoRepository.save() lo inserta en la coleccion eventos_pedido." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=6;spacingRight=6;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;fontSize=10;" vertex="1" parent="1"><mxGeometry x="820" y="90" width="340" height="220" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
