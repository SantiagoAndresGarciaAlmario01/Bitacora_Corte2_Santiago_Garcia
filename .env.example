# Copien este archivo a ".env" (que NO se sube al repositorio, esta en .gitignore)
# y completen sus propios valores antes de levantar el stack con docker compose.

POSTGRES_DB=sushicraft
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

MONGO_DB=sushicraft

# Clave Base64 de al menos 32 bytes para firmar los JWT (HS256).
# Generar una propia, por ejemplo con: openssl rand -base64 32
JWT_SECRET=
JWT_EXPIRATION=86400000
